  {"q": "What does the author call thinking?", "a": "A duty (fariḍa) that allows no exemption or suspension", "key": [["duty", "obligat", "fariḍa", "farida", "fard", "فريضة", "fardh", "mandatory", "required", "compulsory", "imperative"], ["exempt", "exception", "suspen", "waiver", "excus", "dispens", "رخصة", "تعطيل", "pause", "optional"]]},
